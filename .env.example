# Copy to .env and adjust. Every value has a default that reproduces the current
# walletadapter.org deployment, so an unconfigured build is a working build.
#
# .env is gitignored. Nothing here is a secret — a GA measurement ID is public by
# design — but keep it that way if you add anything else.

# Where the site is mounted on its host.
#   /tvmjs-site  → https://example.org/tvmjs-site         (nested, the current deployment)
#   (empty) → https://example.org/              (standalone, served from the root)
# The docs are always mounted at "${BASE_PATH}/docs/".
BASE_PATH=/tvmjs-site

# Public origin including BASE_PATH. Used for canonical links and Open Graph URLs only.
SITE_URL=https://walletadapter.org/tvmjs-site

# Google Analytics measurement ID. Leave empty to ship no analytics at all —
# that is the default for forks and for every non-production build.
NEXT_PUBLIC_GA_ID=
